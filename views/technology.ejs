<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/shared.css">
    <style>
        /* Page-specific styles for Technology page */
        
        /* Hero Section */
        .hero {
            padding: 140px 0 80px;
            background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
            position: relative;
            overflow: hidden;
        }
        
        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 80%;
            height: 150%;
            background: radial-gradient(circle, rgba(0, 174, 239, 0.03) 0%, transparent 70%);
            animation: float 20s ease-in-out infinite;
        }
        
        .hero::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: repeating-linear-gradient(45deg, transparent, transparent 100px, rgba(8, 48, 80, 0.01) 100px, rgba(8, 48, 80, 0.01) 101px);
            pointer-events: none;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0) translateX(0); }
            25% { transform: translateY(-20px) translateX(10px); }
            50% { transform: translateY(10px) translateX(-5px); }
            75% { transform: translateY(-10px) translateX(-10px); }
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: 1.3fr 0.7fr;
            gap: 80px;
            align-items: center;
        }
        
        .hero-left {
            max-width: 700px;
        }
        
        .hero-label {
            display: inline-flex;
            align-items: center;
            padding: 12px 20px;
            margin-bottom: 32px;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border-left: 3px solid var(--cyan-primary);
            box-shadow: var(--glass-shadow);
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--gray-600);
            font-weight: 600;
            animation: fadeInScale 0.8s var(--ease-out-expo) 0.4s backwards;
        }
        
        @keyframes fadeInScale {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        h1 {
            font-size: clamp(3rem, 6vw, 5rem);
            font-weight: 900;
            line-height: 0.95;
            margin-bottom: 32px;
            letter-spacing: -0.03em;
            color: var(--navy-primary);
            animation: fadeInUp 0.8s var(--ease-out-expo) 0.5s backwards;
        }
        
        .hero-description {
            font-size: 18px;
            line-height: 1.5;
            color: var(--gray-600);
            margin-bottom: 48px;
            font-weight: 450;
            animation: fadeInUp 0.8s var(--ease-out-expo) 0.6s backwards;
        }
        
        /* Stats cards */
        .hero-stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            animation: fadeInScale 0.8s var(--ease-out-expo) 0.7s backwards;
        }
        
        .stat-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 100%);
            backdrop-filter: blur(10px);
            padding: 40px 24px;
            min-height: 140px;
            text-align: center;
            box-shadow: var(--glass-shadow);
            transition: all var(--transition-base);
            cursor: pointer;
            border: 1px solid var(--glass-border);
            position: relative;
            overflow: hidden;
        }
        
        .stat-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 40px rgba(0, 174, 239, 0.15);
            border-color: rgba(0, 174, 239, 0.3);
        }
        
        .stat-value {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--navy-primary);
            margin-bottom: 12px;
            line-height: 1;
            transition: all var(--transition-base);
        }
        
        .stat-card:hover .stat-value {
            color: var(--cyan-primary);
            transform: scale(1.05);
        }
        
        .stat-label {
            font-size: 10px;
            color: var(--gray-500);
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }
        
        /* Systems Section */
        .systems {
            padding: 100px 0;
            background: white;
            position: relative;
        }
        
        .systems::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: repeating-linear-gradient(-45deg, transparent, transparent 120px, rgba(229, 231, 235, 0.15) 120px, rgba(229, 231, 235, 0.15) 121px);
            pointer-events: none;
        }
        
        .section-header {
            text-align: center;
            margin-bottom: 80px;
            position: relative;
            z-index: 2;
        }
        
        .section-label {
            display: inline-block;
            font-size: 11px;
            color: var(--cyan-primary);
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            margin-bottom: 24px;
            padding: 8px 20px;
            background: rgba(0, 174, 239, 0.08);
        }
        
        .section-title {
            font-size: clamp(2rem, 4vw, 3.5rem);
            font-weight: 900;
            color: var(--navy-primary);
            line-height: 1.1;
        }
        
        .systems-grid {
            display: grid;
            gap: 100px;
            position: relative;
            z-index: 2;
        }
        
        /* System cards */
        .system-card {
            display: grid;
            grid-template-columns: 1fr 540px;
            gap: 80px;
            align-items: center;
        }
        
        .system-card:nth-child(even) {
            grid-template-columns: 540px 1fr;
        }
        
        .system-card:nth-child(even) .system-content {
            order: 2;
        }
        
        .system-card:nth-child(even) .system-visual {
            order: 1;
        }
        
        .system-header {
            display: flex;
            align-items: flex-start;
            gap: 24px;
            margin-bottom: 24px;
        }
        
        .system-number {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, var(--cyan-primary), var(--cyan-dark));
            color: white;
            font-size: 20px;
            font-weight: 900;
            flex-shrink: 0;
            box-shadow: 0 4px 16px rgba(0, 174, 239, 0.2);
        }
        
        .system-name {
            font-size: 2rem;
            font-weight: 900;
            color: var(--navy-primary);
            margin-bottom: 8px;
            line-height: 1;
        }
        
        .system-badge {
            display: inline-block;
            padding: 6px 14px;
            background: rgba(0, 174, 239, 0.08);
            border: 1px solid rgba(0, 174, 239, 0.2);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--cyan-primary);
        }
        
        .system-description {
            font-size: 16px;
            line-height: 1.6;
            color: var(--gray-600);
            margin-bottom: 32px;
        }
        
        .system-description strong {
            font-weight: 700;
            color: var(--navy-primary);
        }
        
        /* Features */
        .features {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }
        
        .feature {
            padding: 20px;
            background: linear-gradient(135deg, rgba(249, 250, 251, 0.95) 0%, rgba(243, 244, 246, 0.85) 100%);
            border-left: 3px solid var(--gray-300);
            transition: all var(--transition-base);
        }
        
        .feature:hover {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.95) 100%);
            border-left-color: var(--cyan-primary);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
            transform: translateX(4px);
        }
        
        .feature-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--navy-primary);
            margin-bottom: 8px;
        }
        
        .feature-desc {
            font-size: 13px;
            color: var(--gray-600);
            line-height: 1.5;
        }
        
        /* System visuals */
        .system-visual {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(250, 250, 250, 0.85) 100%);
            backdrop-filter: blur(10px);
            padding: 48px;
            min-height: 440px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            box-shadow: var(--glass-shadow);
            border: 1px solid var(--glass-border);
            overflow: hidden;
        }
        
        .system-visual::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 150%;
            height: 150%;
            background: radial-gradient(circle, rgba(0, 174, 239, 0.05) 0%, transparent 60%);
            animation: rotate 30s linear infinite;
        }
        
        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        .system-visual > * {
            position: relative;
            z-index: 2;
        }
        
        /* Visual 1: Network */
        .visual-network {
            width: 100%;
            max-width: 360px;
            margin: 0 auto;
        }
        
        .network-svg {
            width: 100%;
            height: auto;
        }
        
        .network-node {
            cursor: pointer;
            transition: all 600ms ease;
        }
        
        .network-node:hover {
            transform: scale(1.08);
        }
        
        /* Visual 2: Segments */
        .visual-segments {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            max-width: 400px;
        }
        
        .segment-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.95) 100%);
            padding: 32px 24px;
            text-align: center;
            border: 2px solid var(--gray-200);
            transition: all var(--transition-base);
            box-shadow: var(--glass-shadow);
        }
        
        .segment-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
        }
        
        .segment-card.untapped {
            border-color: rgba(220, 38, 38, 0.3);
            background: linear-gradient(135deg, rgba(220, 38, 38, 0.02), rgba(220, 38, 38, 0.01));
        }
        
        .segment-icon {
            width: 48px;
            height: 48px;
            margin: 0 auto 16px;
            background: var(--gray-200);
            border-radius: 50%;
        }
        
        .segment-card.untapped .segment-icon {
            background: rgba(220, 38, 38, 0.15);
        }
        
        .segment-label {
            font-size: 14px;
            font-weight: 700;
            color: var(--navy-primary);
            margin-bottom: 8px;
        }
        
        .segment-value {
            font-size: 11px;
            color: var(--gray-600);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
        
        .segment-card.untapped .segment-value {
            color: #dc2626;
        }
        
        /* Visual 3: Analysis */
        .visual-analysis {
            width: 100%;
            max-width: 440px;
        }
        
        .analysis-display {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.95) 100%);
            padding: 32px;
            border: 1px solid var(--glass-border);
            box-shadow: var(--glass-shadow);
        }
        
        .analysis-header {
            font-size: 12px;
            font-weight: 800;
            color: var(--navy-primary);
            margin-bottom: 24px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding-bottom: 16px;
            border-bottom: 2px solid var(--cyan-primary);
        }
        
        .keyword-flow {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }
        
        .keyword-input {
            flex: 1;
            padding: 16px;
            background: rgba(243, 244, 246, 0.5);
            font-size: 14px;
            color: var(--gray-700);
            border: 1px solid var(--gray-200);
            font-weight: 500;
        }
        
        .flow-arrow {
            color: var(--cyan-primary);
            font-size: 24px;
            font-weight: 900;
        }
        
        .keyword-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        
        .keyword-tag {
            padding: 8px 16px;
            background: rgba(255, 255, 255, 0.8);
            border: 2px solid var(--cyan-primary);
            font-size: 12px;
            font-weight: 700;
            color: var(--navy-primary);
            transition: all var(--transition-fast);
            cursor: pointer;
        }
        
        .keyword-tag:hover {
            background: var(--cyan-primary);
            color: white;
            transform: translateY(-2px);
        }
        
        /* Visual 4: Efficiency */
        .visual-efficiency {
            width: 100%;
            max-width: 440px;
        }
        
        .efficiency-chart {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.95) 100%);
            padding: 32px;
            border: 1px solid var(--glass-border);
            box-shadow: var(--glass-shadow);
        }
        
        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--gray-200);
        }
        
        .chart-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--navy-primary);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }
        
        .chart-value {
            font-size: 36px;
            font-weight: 900;
            color: var(--cyan-primary);
        }
        
        .chart-graph {
            height: 120px;
            background: linear-gradient(180deg, rgba(0, 174, 239, 0.05) 0%, rgba(0, 174, 239, 0) 100%);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(0, 174, 239, 0.1);
        }
        
        .chart-line {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 65%;
            background: linear-gradient(135deg, var(--cyan-primary), var(--cyan-dark));
            clip-path: polygon(0 100%, 10% 78%, 25% 82%, 40% 58%, 55% 38%, 70% 28%, 85% 18%, 100% 8%, 100% 100%);
        }
        
        .chart-labels {
            display: flex;
            justify-content: space-around;
            padding-top: 12px;
            border-top: 1px solid var(--gray-200);
            margin-top: 16px;
        }
        
        .chart-label {
            font-size: 10px;
            font-weight: 700;
            color: var(--gray-600);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        
        /* Visual 5: Market Grid */
        .visual-market {
            width: 100%;
            max-width: 440px;
        }
        
        .market-display {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.95) 100%);
            padding: 32px;
            border: 1px solid var(--glass-border);
            box-shadow: var(--glass-shadow);
        }
        
        .market-header {
            font-size: 12px;
            font-weight: 800;
            color: var(--navy-primary);
            margin-bottom: 24px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding-bottom: 16px;
            border-bottom: 2px solid var(--cyan-primary);
        }
        
        .market-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-bottom: 24px;
        }
        
        .market-cell {
            padding: 12px 4px;
            background: rgba(243, 244, 246, 0.5);
            text-align: center;
            font-size: 11px;
            font-weight: 700;
            color: var(--gray-600);
            border: 2px solid transparent;
            transition: all var(--transition-fast);
            cursor: pointer;
        }
        
        .market-cell:hover {
            transform: scale(1.1);
            z-index: 10;
        }
        
        .market-cell.hot {
            background: rgba(220, 38, 38, 0.08);
            color: #dc2626;
            border-color: rgba(220, 38, 38, 0.3);
            font-weight: 800;
        }
        
        .market-cell.warm {
            background: rgba(0, 174, 239, 0.08);
            color: var(--cyan-dark);
            border-color: rgba(0, 174, 239, 0.3);
            font-weight: 800;
        }
        
        .market-legend {
            display: flex;
            justify-content: center;
            gap: 24px;
        }
        
        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 10px;
            font-weight: 700;
            color: var(--gray-600);
            text-transform: uppercase;
        }
        
        .legend-item::before {
            content: '';
            width: 12px;
            height: 12px;
            background: var(--gray-200);
        }
        
        .legend-item.hot::before {
            background: rgba(220, 38, 38, 0.2);
            border: 2px solid #dc2626;
        }
        
        .legend-item.warm::before {
            background: rgba(0, 174, 239, 0.2);
            border: 2px solid var(--cyan-primary);
        }
        
        /* Visual 6: Dashboard */
        .visual-dashboard {
            width: 100%;
            max-width: 440px;
        }
        
        .dashboard-display {
            background: var(--navy-primary);
            padding: 32px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(8, 48, 80, 0.2);
        }
        
        .dashboard-display::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(0, 174, 239, 0.05) 0%, transparent 50%, rgba(0, 174, 239, 0.02) 100%);
        }
        
        .dashboard-content {
            position: relative;
            z-index: 2;
        }
        
        .dashboard-header {
            color: var(--cyan-primary);
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 24px;
        }
        
        .race-tracks {
            display: grid;
            gap: 16px;
        }
        
        .race-track {
            display: grid;
            grid-template-columns: 110px 1fr 70px;
            align-items: center;
            gap: 12px;
        }
        
        .track-label {
            font-size: 12px;
            font-weight: 600;
            color: white;
        }
        
        .track-bar {
            height: 28px;
            background: rgba(255, 255, 255, 0.08);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .track-progress {
            height: 100%;
            background: linear-gradient(90deg, var(--gray-600), var(--gray-700));
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 8px;
            transition: width 1.5s var(--ease-out-expo);
        }
        
        .race-track.winner .track-progress {
            background: linear-gradient(90deg, var(--cyan-primary), var(--cyan-dark));
        }
        
        .track-value {
            font-size: 11px;
            font-weight: 700;
            color: white;
        }
        
        .track-result {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.5);
        }
        
        .race-track.winner .track-result {
            color: var(--cyan-primary);
        }
        
        /* CTA Section */
        .cta {
            padding: 120px 0;
            background: var(--navy-primary);
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .cta::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(0, 174, 239, 0.1) 0%, transparent 60%);
            animation: rotate 30s linear infinite reverse;
        }
        
        .cta::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: repeating-linear-gradient(45deg, transparent, transparent 100px, rgba(255, 255, 255, 0.02) 100px, rgba(255, 255, 255, 0.02) 101px);
            pointer-events: none;
        }
        
        .cta-content {
            position: relative;
            z-index: 2;
        }
        
        .cta-title {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 900;
            margin-bottom: 24px;
            line-height: 1.1;
        }
        
        .cta-title .highlight {
            color: var(--cyan-primary);
            position: relative;
        }
        
        .cta-description {
            font-size: 18px;
            opacity: 0.9;
            margin-bottom: 48px;
            max-width: 640px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.5;
        }
        
        
        .cta-button::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: var(--cyan-light);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: all 0.6s var(--ease-out-expo);
        }
        
        .cta-button:hover::before {
            width: 300%;
            height: 300%;
        }
        
        .cta-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(64, 196, 255, 0.3);
            background: var(--cyan-light);
        }
        
        .cta-button span {
            position: relative;
            z-index: 1;
        }
        
        /* Responsive */
        @media (max-width: 1024px) {
            .hero-content { grid-template-columns: 1fr; gap: 48px; }
            .hero-stats { max-width: 600px; }
            .system-card, .system-card:nth-child(even) { grid-template-columns: 1fr; gap: 48px; }
            .system-card:nth-child(even) .system-content { order: 1; }
            .system-card:nth-child(even) .system-visual { order: 2; }
        }
        
        @media (max-width: 768px) {
            .hero { padding: 100px 0 60px; }
            h1 { font-size: 2.5rem; margin-bottom: 24px; }
            .hero-description { font-size: 16px; margin-bottom: 32px; }
            .hero-stats { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 16px; margin: 0 -20px; padding-left: 20px; padding-right: 20px; }
            .stat-card { min-width: 160px; padding: 32px 20px; scroll-snap-align: start; flex-shrink: 0; }
            .systems { padding: 60px 0; }
